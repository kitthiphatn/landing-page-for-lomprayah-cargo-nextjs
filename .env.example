# SQLite file kept inside this site's folder, so nothing is shared with other sites on the server
DATABASE_URL=file:./data/lp-cargo.db
# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=change-me
# Folder for images uploaded in the admin panel. On the server, point it outside the app folder.
MEDIA_DIR=media
# Public URL of the site
NEXT_PUBLIC_SERVER_URL=http://localhost:3005
# Parcel tracking API.
# Leave NEXT_PUBLIC_TRACKING_API empty to send lookups through this site's /tracking-api forwarder
# (needed on any domain other than lomprayahcargo.com, because the API only allows that domain).
# On www.lomprayahcargo.com set it to the API itself, so each visitor's browser calls it directly
# and the 60 requests/minute limit applies per visitor instead of to the server.
NEXT_PUBLIC_TRACKING_API=
# Where /tracking-api forwards to. Read at build time.
TRACKING_API_UPSTREAM=https://api.lomprayahcargo.com/api
